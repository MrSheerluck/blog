---
import { config } from "virtual:nimbus/config";
import type { HeadElement } from "@cloudflare/nimbus-docs/types";
import type { LanguageLink, Locale } from "../i18n/config";
import { localeTag } from "../i18n/config";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  markdownUrl?: string;
  socialImage?: string;
  lastUpdated?: Date;
  publishedDateISO?: string;
  head?: HeadElement[];
  locale: Locale;
  languageLinks: LanguageLink[];
}

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  lastUpdated,
  publishedDateISO,
  head: pageHead = [],
  locale,
  languageLinks,
} = Astro.props;

const lang = localeTag(locale);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
const fullTitle = title !== config.title ? `${title} | ${config.title}` : title;
const resolvedDescription = description ?? config.description;
const ogImage = socialImage ?? config.socialImage ?? "/og.png";
const absoluteOgImage = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const headExtras: HeadElement[] = [
  ...languageLinks.map((link) => ({
    tag: "link" as const,
    attrs: {
      rel: "alternate",
      hreflang: localeTag(link.locale),
      href: Astro.site ? new URL(link.href, Astro.site).href : link.href,
    },
  })),
  {
    tag: "link",
    attrs: {
      rel: "alternate",
      hreflang: "x-default",
      href: Astro.site ? new URL(languageLinks[0]?.href ?? "/", Astro.site).href : languageLinks[0]?.href ?? "/",
    },
  },
  {
    tag: "script",
    attrs: { type: "application/ld+json" },
    content: JSON.stringify({
      "@context": "https://schema.org",
      "@type": publishedDateISO ? "Article" : "WebPage",
      name: fullTitle,
      ...(resolvedDescription ? { description: resolvedDescription } : {}),
      url: canonical,
      inLanguage: lang,
      ...(absoluteOgImage ? { image: absoluteOgImage } : {}),
      ...(lastUpdated ? { dateModified: lastUpdated.toISOString() } : {}),
      ...(publishedDateISO ? { datePublished: publishedDateISO } : {}),
    }),
  },
  ...pageHead,
];
---

<title>{fullTitle}</title>
<meta name="generator" content={Astro.generator} />
{resolvedDescription && <meta name="description" content={resolvedDescription} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
<link rel="stylesheet" href={`${import.meta.env.BASE_URL}_nimbus/shiki.css${import.meta.env.DEV ? `?v=${Date.now()}` : ""}`} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
{markdownUrl && <link rel="alternate" type="text/markdown" href={markdownUrl} />}
<meta property="og:title" content={fullTitle} />
<meta property="og:type" content="article" />
<meta property="og:site_name" content={config.title} />
<meta property="og:locale" content={lang} />
{languageLinks.filter((link) => link.locale !== locale).map((link) => (
  <meta property="og:locale:alternate" content={link.locale === "pt-br" ? "pt-BR" : link.locale} />
))}
{resolvedDescription && <meta property="og:description" content={resolvedDescription} />}
<meta property="og:url" content={canonical} />
{absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
{resolvedDescription && <meta name="twitter:description" content={resolvedDescription} />}
{absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
{lastUpdated && <meta property="article:modified_time" content={lastUpdated.toISOString()} />}
{publishedDateISO && <meta property="article:published_time" content={publishedDateISO} />}
{headExtras.map(({ tag: Tag, attrs = {}, content }) =>
  content ? <Tag {...attrs} set:html={content} /> : <Tag {...attrs} />
)}
