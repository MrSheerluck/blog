---
import type { Job } from "../lib/jobs";

interface Props {
  job: Job;
}

const { job } = Astro.props;

const formattedDate = job.updatedAt
  ? new Date(job.updatedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : null;
---

<a
  href={job.url}
  target="_blank"
  rel="noopener"
  class="group flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-4 px-4 py-3 rounded-lg no-underline transition-colors hover:bg-accent/60"
>
  <div class="min-w-0 flex-1">
    <span class="font-medium text-foreground group-hover:text-primary transition-colors">
      {job.title}
    </span>
    <span class="ml-2 text-sm text-muted-foreground">
      {job.company}{job.location ? ` · ${job.location}` : ""}
    </span>
  </div>
  {formattedDate && (
    <time datetime={job.updatedAt} class="text-xs text-muted-foreground whitespace-nowrap">
      {formattedDate}
    </time>
  )}
</a>
