    "rust-calculator": {
      intro: "इस श्रृंखला में हम हर लेख में एक project बनाकर Rust सीखेंगे। इस पहले project में variables और types समझने के लिए एक simple scientific calculator बनाएँगे।",
      sections: [
        { heading: "पूर्व-आवश्यकताएँ", paragraphs: ["आपको किसी एक programming language और conditions, variables, loops तथा functions का basic knowledge होना चाहिए। सबसे जरूरी है सीखने और मेहनत करने की इच्छा; यह लंबी यात्रा होगी।"] },
        { heading: "Rust और Cargo install करना", paragraphs: ["rustup से Rust install करें और rustc --version, cargo --version तथा rustup --version चलाकर जाँचें। Cargo Rust का build system और package manager है। cargo new project बनाता है, cargo check code जाँचता है, cargo run compile और run करता है और cargo build compile करता है।"] },
        { heading: "Variables, mutability और shadowing", paragraphs: ["let name और value के बीच binding बनाता है। Bindings default रूप से immutable होती हैं; बदलने के लिए mut लगाएँ। Reassignment उसी binding को बदलता है, जबकि shadowing उसी नाम की नई binding बनाता है और उसका type भी बदल सकता है।"] },
        { heading: "Scope और storage", paragraphs: ["Binding केवल अपने scope में उपलब्ध होती है। Nested block में बनी binding block से बाहर निकलते ही उपलब्ध नहीं रहती। Stack, registers, ownership और lifetimes की गहराई बाद में आएगी; अभी language behavior पर ध्यान दें।"] },
