        { heading: "विंडो, आकार और styling", paragraphs: ["gpui_platform::application() से event loop शुरू करें, components initialize करें और cx.open_window से window बनाएँ। WindowBounds से निश्चित आकार दें। GPUI में dimensions px() जैसी typed units में और styles chained methods से लिखे जाते हैं।"] },
        { heading: "Flexbox layout", paragraphs: ["मुख्य container size_full(), flex() और flex_row() से sidebar तथा content area को अलग करता है। Sidebar की width fixed है और flex_1() बाकी space content को देता है। flex_col(), gap(), padding और borders layout पूरा करते हैं।"] },
        { heading: "Reusable components", paragraphs: ["sidebar_item, project_item, tab, group_header और issue जैसी functions दोहराए जाने वाले structures को encapsulate करती हैं। when(), when_some() और hover() जैसी conditional APIs markup दोहराए बिना UI बदलने देती हैं।"] },
        { heading: "Sidebar और main content", paragraphs: ["Sidebar में workspace selector, search, navigation, projects और user section जोड़ें। Main area में header, title, tabs, groups और issue cards जोड़ें। rust-embed से SVG assets binary में embed करके AssetSource के माध्यम से GPUI को दिए जा सकते हैं।"] },
        { heading: "सारांश", paragraphs: ["एक div से शुरू करके हमने composition से पूरी interface बनाई। आपने dimensions, spacing, colors, borders, flex_1(), mt_auto() और conditional rendering सीखी। अगले लेख में interface user actions पर प्रतिक्रिया देगी।"] },
      ],
