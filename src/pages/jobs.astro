---
import DocsLayout from "../layouts/DocsLayout.astro";
import SeriesSidebar from "../components/SeriesSidebar.astro";
import JobRow from "../components/JobRow.astro";
import { config } from "virtual:nimbus/config";
import { getAllJobs, TECH_STACKS, EXPERIENCE_LEVELS } from "../lib/jobs";

const PAGE_SIZE = 25;

const { jobs } = await getAllJobs();
const firstPage = jobs.slice(0, PAGE_SIZE);

const companies = [...new Set(jobs.map((j) => j.company))].sort();
const issueUrl = config.github
  ? `${config.github}/issues/new?title=${encodeURIComponent("Job board: add a company")}`
  : null;
---

<DocsLayout
  title="Jobs"
  description="Open roles across tech. Filter by company, tech stack, or experience level."
  sidebar={[]}
  headings={false}
  breadcrumbs={[]}
  prevNext={{}}
>
  <SeriesSidebar slot="sidebar" />

  <div class="mt-6 flex flex-wrap items-end gap-x-4 gap-y-3">
    <label class="flex flex-col gap-1 text-xs font-medium text-muted-foreground">
      Company
      <select
        id="filter-company"
        class="rounded-md border border-border bg-background px-2 py-1.5 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
      >
        <option value="">All</option>
        {companies.map((c) => <option value={c}>{c}</option>)}
      </select>
    </label>
    <label class="flex flex-col gap-1 text-xs font-medium text-muted-foreground">
      Tech stack
      <select
        id="filter-tech"
        class="rounded-md border border-border bg-background px-2 py-1.5 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
      >
        <option value="">All</option>
        {TECH_STACKS.map((t) => <option value={t}>{t}</option>)}
      </select>
    </label>
    <label class="flex flex-col gap-1 text-xs font-medium text-muted-foreground">
      Experience
      <select
        id="filter-exp"
        class="rounded-md border border-border bg-background px-2 py-1.5 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-ring"
      >
        <option value="">All</option>
        {EXPERIENCE_LEVELS.map((e) => <option value={e}>{e}</option>)}
      </select>
    </label>
    <button
      id="filter-reset"
      class="hidden rounded-lg border border-border px-3 py-1.5 text-sm font-medium text-foreground transition-colors hover:border-border-strong"
    >
      Reset filters
    </button>
  </div>

  <p id="jobs-status" class="text-sm text-muted-foreground" aria-live="polite"></p>

  <ol id="jobs-list" class="divide-y divide-border list-none pl-0">
    {firstPage.map((job) => (
      <li class="m-0"><JobRow job={job} /></li>
    ))}
  </ol>
  {jobs.length === 0 && (
    <p class="text-muted-foreground">No jobs found right now — check back later.</p>
  )}

  <nav id="pager" class="hidden items-center justify-center gap-4" aria-label="Pagination">
    <button
      id="pager-prev"
      class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong disabled:pointer-events-none disabled:opacity-40"
    >
      Previous
    </button>
    <span id="pager-info" class="text-sm text-muted-foreground"></span>
    <button
      id="pager-next"
      class="rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground no-underline transition-colors hover:border-border-strong disabled:pointer-events-none disabled:opacity-40"
    >
      Next
    </button>
  </nav>

  {issueUrl && (
    <p class="text-sm text-muted-foreground">
      Missing a company?{" "}
      <a
        href={issueUrl}
        target="_blank"
        rel="noopener"
        class="text-primary hover:text-primary/80 underline underline-offset-2"
      >
        Open an issue on GitHub
      </a>{" "}
      and I'll add its board.
    </p>
  )}
</DocsLayout>

<script>
  interface Job {
    title: string;
    company: string;
    location: string;
    url: string;
    updatedAt: string | null;
    tech: string[];
    experience: string;
  }

  const list = document.getElementById("jobs-list") as HTMLElement | null;
  if (list) {
    fetch("/jobs.json")
      .then((res) => res.json())
      .then((data: { jobs: Job[]; pageSize: number }) => {
      const statusEl = document.getElementById("jobs-status")!;
      const companySel = document.getElementById("filter-company") as HTMLSelectElement;
      const techSel = document.getElementById("filter-tech") as HTMLSelectElement;
      const expSel = document.getElementById("filter-exp") as HTMLSelectElement;
      const resetBtn = document.getElementById("filter-reset")!;
      const pager = document.getElementById("pager")!;
      const prevBtn = document.getElementById("pager-prev") as HTMLButtonElement;
      const nextBtn = document.getElementById("pager-next") as HTMLButtonElement;
      const infoEl = document.getElementById("pager-info")!;

      let page = 1;

      const esc = (s: string) =>
        s.replace(/[&<>"']/g, (c) =>
          ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
        );

      const fmtDate = (iso: string | null) =>
        iso
          ? new Date(iso).toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
            })
          : null;

      function rowHTML(job: Job): string {
        const date = fmtDate(job.updatedAt);
        return `<a href="${esc(job.url)}" target="_blank" rel="noopener" class="group flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:gap-4 no-underline transition-colors">
  <div class="min-w-0 flex-1">
    <span class="font-medium text-foreground group-hover:text-primary transition-colors">${esc(job.title)}</span>
    <span class="block mt-0.5 text-sm text-muted-foreground">${esc(job.company)}${job.location ? ` · ${esc(job.location)}` : ""}</span>
    ${(job.tech.length || job.experience !== "Not specified") ? `<div class="mt-1.5 flex flex-wrap gap-1.5">${job.experience !== "Not specified" ? `<span class="rounded-full border border-border px-2 py-0.5 text-[0.6875rem] text-muted-foreground">${esc(job.experience)}</span>` : ""}${job.tech.slice(0, 6).map((t) => `<span class="rounded-full border border-border px-2 py-0.5 text-[0.6875rem] text-muted-foreground">${esc(t)}</span>`).join("")}${job.tech.length > 6 ? `<span class="px-1 text-[0.6875rem] text-muted-foreground">+${job.tech.length - 6}</span>` : ""}</div>` : ""}
  </div>
  ${date ? `<time datetime="${esc(job.updatedAt!)}" class="text-xs text-muted-foreground whitespace-nowrap self-start sm:self-center">${date}</time>` : ""}
</a>`;
      }

      function render() {
        const company = companySel.value;
        const tech = techSel.value;
        const exp = expSel.value;

        const filtered = data.jobs.filter(
          (j) =>
            (!company || j.company === company) &&
            (!tech || j.tech.includes(tech)) &&
            (!exp || j.experience === exp),
        );
        const totalPages = Math.max(1, Math.ceil(filtered.length / data.pageSize));
        page = Math.min(Math.max(1, page), totalPages);

        const start = (page - 1) * data.pageSize;
        const slice = filtered.slice(start, start + data.pageSize);

        list!.innerHTML = slice
          .map((j) => `<li class="m-0">${rowHTML(j)}</li>`)
          .join("");

        statusEl.textContent = filtered.length
          ? `Showing ${start + 1}–${start + slice.length} of ${filtered.length} roles`
          : "No roles match your filters.";

        infoEl.textContent = `Page ${page} of ${totalPages}`;
        prevBtn.disabled = page <= 1;
        nextBtn.disabled = page >= totalPages;
        pager.classList.remove("hidden");
        pager.classList.add("flex");

        resetBtn.classList.toggle("hidden", !company && !tech && !exp);
      }

      companySel.addEventListener("change", () => {
        page = 1;
        render();
      });
      techSel.addEventListener("change", () => {
        page = 1;
        render();
      });
      expSel.addEventListener("change", () => {
        page = 1;
        render();
      });
      prevBtn.addEventListener("click", () => {
        page -= 1;
        render();
      });
      nextBtn.addEventListener("click", () => {
        page += 1;
        render();
      });
      resetBtn.addEventListener("click", () => {
        companySel.value = "";
        techSel.value = "";
        expSel.value = "";
        page = 1;
        render();
      });

      render();
        })
      .catch(() => {
        const statusEl = document.getElementById("jobs-status")!;
        statusEl.textContent = "Couldn't load the job listings. Please refresh and try again.";
      });
  }
</script>
